# Optional Gemini configuration:
# When GEMINI_API_KEY is present, vision extraction uses Gemini by default.
# Set VISION_PROVIDER=mock only for local tests; it returns illustrative mock output.
# GEMINI_VISION_MODEL=gemini-3.5-flash-lite
# VISION_PROVIDER=gemini
# GEMINI_API_KEY=configure in the host's secret manager; never commit a real key

PORT=8000
HOST=0.0.0.0


