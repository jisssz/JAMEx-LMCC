    "@radix-ui/react-tooltip": "^1.4.1",
    "@types/canvas-confetti": "^1.9.0",
    "@zxing/library": "^0.23.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.6.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.16.0",
    "ogl": "^1.0.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
