{
  "name": "lmcc-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "tsx --test tests/unit_tests.ts",
    "test:export": "tsx --test tests/export_tests.ts",
    "test:vision": "tsx --test tests/vision_fallback_test.ts",
    "test:copilot": "tsx --test tests/copilot_review_tests.ts",
    "test:summary": "tsx --test tests/ai_summary_tests.ts",
    "test:image": "tsx --test tests/image_and_dual_ocr_tests.ts",
    "test:all": "tsx --test tests/unit_tests.ts && tsx --test tests/export_tests.ts && tsx --test tests/vision_fallback_test.ts && tsx --test tests/copilot_review_tests.ts && tsx --test tests/ai_summary_tests.ts && tsx --test tests/image_and_dual_ocr_tests.ts",
    "benchmark:parser": "tsx evaluation/runners/parserBenchmark.ts",
    "benchmark:rules": "tsx evaluation/runners/rulesBenchmark.ts",
    "benchmark:generate": "tsx evaluation/runners/generateSynthetic.ts",
    "benchmark:ocr": "tsx evaluation/runners/ocrBenchmark.ts",
    "benchmark:vision": "tsx evaluation/runners/aiVisionBenchmark.ts",
    "benchmark:all": "tsx evaluation/runners/parserBenchmark.ts && tsx evaluation/runners/rulesBenchmark.ts && tsx evaluation/runners/aiVisionBenchmark.ts"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.2.1",
